# Copy to .env for local development. Placeholders only: never put real
# credentials in this file. Production values come from AWS secrets management.

APP_NAME="Calendar Lead Info"
APP_ENV=local
# Generate locally with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stdout = structured JSON for the Datadog agent; use `single` for a local file log.
LOG_CHANNEL=stdout
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# docker-compose MySQL (host port 3307; local-only credentials).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=calendar_lead_info
DB_USERNAME=calendar
DB_PASSWORD=calendar

SESSION_DRIVER=array

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queues: sync, digest, maintenance (see config/queue.php `queues`).
QUEUE_CONNECTION=database

# Database cache store backs scheduler onOneServer() locks.
CACHE_STORE=database

# Local mail goes to Mailpit (UI at http://localhost:8025).
# Production: MAIL_MAILER=ses plus the AWS_* keys below.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="digest@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SES credentials (production only; leave empty locally).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Calendar provider (config/calendar.php).
CALENDAR_PROVIDER=fake
CALENDAR_ALLOW_FAKE=false
CALENDAR_PROVIDER_TIMEOUT=10
CALENDAR_CAP_MULTIPLIER=3
CALENDAR_FAKE_MODE=ok
CALENDAR_FAKE_LATENCY_MS=0

# Daily digest schedule, in each rep's local timezone (config/digest.php).
DIGEST_SEND_HOUR=8
DIGEST_SEND_WINDOW_MINUTES=15
DIGEST_SYNC_HOUR=5
DIGEST_SYNC_CUTOFF=07:45
DIGEST_RETENTION_DAYS=35
